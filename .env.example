# Butler reads this file from the repo root, then %APPDATA%\Butler\.env.
# Every default lane, including the voice, runs on Gemini.
GEMINI_API_KEY=
# Optional: the Realtime voice engine, the wake word, and computer use.
OPENAI_API_KEY=
# Optional: local "Butler" wake word through Picovoice Porcupine (free personal tier).
PICOVOICE_ACCESS_KEY=
# Optional: Meta Model API (Muse Voice Transcribe live captions, Muse Spark lanes).
META_API_KEY=
# Optional: only if a lane in config.json points at Claude.
ANTHROPIC_API_KEY=
# Phone relay (remote/ deployed on Vercel): the same value as the Vercel env var.
BUTLER_PC_TOKEN=
